# Real telemetry: chat titles, spend, host addresses. Never commit.
reports/
*.db
*.db-wal
*.db-shm

# Synthetic samples ARE committed (examples/reports/) so a clone renders.
# live-data.json and ollama-data.json are committed TOO: the DOM suites read
# them directly, so excluding them makes CI unrunnable on a fresh clone.
!examples/reports/
examples/reports/pricing-cache.json
examples/reports/nous-pricing-cache.json
# Runtime state the collectors write next to the samples (per-profile
# bandwidth ledger, probed host capabilities). Machine-local, never samples.
examples/reports/bandwidth-history.json
examples/reports/.ollama-caps.json

__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

node_modules/
tests/node_modules

# Parity harness (packages/collectors/parity, T-5 / LLMTELEMET-284): generated
# py/node artifacts and scratch output, never committed (fixtures ARE).
packages/collectors/parity/out/

# Next.js workspace (apps/web, T-0 / LST-281): build output and tool state,
# never committed. deps stay pinned in package-lock.json instead.
apps/web/.next/
apps/web/out/
*.tsbuildinfo
apps/web/test-results/
apps/web/playwright-report/

.DS_Store
*.png
!docs/*.png
examples/reports/_*.html

.preview/

# Git worktrees live only here (never outside the project folder)
.worktrees/
