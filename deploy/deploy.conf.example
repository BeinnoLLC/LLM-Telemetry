# Copy to deploy.conf and edit. deploy.conf is gitignored because it names a
# host and a key path -- the repo ships sanitized fixtures, and the no-abs-path
# guard forbids machine-specific paths in tracked files anyway.

# The always-on box that serves the reports (collecting stays on this machine).
SELENE_HOST=192.168.1.254
SELENE_USER=root

# SSH key used for both the file sync and the container commands.
SSH_KEY=$HOME/.ssh/id_rsa

# Where the reports land on the serving box. On Unraid keep this on the array
# (a share), not in /tmp, so the container still has the files after a reboot.
REMOTE_DIR=/mnt/user/appdata/llm-telemetry/reports

# Container name for the static server.
CONTAINER=llm-telemetry

# Local reports to publish. Defaults to the app's own reports dir.
# REPORTS_DIR=$HOME/.hermes/reports
