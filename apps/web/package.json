    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.29",
    "jsdom": "31.0.1",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
