[Unit]
# T-4 (LST-283) TEMPLATE — NOT INSTALLED by this ticket. Installation is a
# cutover-step decision (migration plan §12 step 4) and needs the user's OK.
# Node twin of systemd/llm-telemetry-probe: ollama-data.json every 5s.
Description=Probe LLM inference hosts via the Node collector CLI (template)

[Service]
Type=oneshot
# Pin the absolute node path (`command -v node`) and the checkout path before
# use. NOTE: `probe` is a stub until T-16; until then this unit would exit
# non-zero with "not yet ported".
Environment=LLM_TELEMETRY_NODE_REPORTS_DIR=%h/.local/share/llm-telemetry/reports-node
ExecStart=/usr/bin/node %h/workspace/beinno/LLM-Telemtry/packages/collectors/dist/cli.js probe
