[Unit]
Description=Rebuild the LLM telemetry dashboard

[Service]
# One cycle = every page and every on-demand payload. Keep this list in step
# with scripts/refresh-dashboard.sh (the cron spelling of the same cycle):
# tests/check_refresh_coverage.js fails if a payload the page fetches has no
# producer here, which is how live-data.json and logs-data.json were silently
# missing on systemd installs while the cron install had them.
Type=oneshot
ExecStart=%h/.local/bin/llm-telemetry dashboard
ExecStart=%h/.local/bin/llm-telemetry live
ExecStart=%h/.local/bin/llm-telemetry logs
ExecStart=%h/.local/bin/llm-telemetry costs
ExecStart=%h/.local/bin/llm-telemetry transcripts
ExecStart=%h/.local/bin/llm-telemetry session-timeline
